# Supabase 프로젝트 설정(supabase.com 대시보드 > Project Settings > API)에서 복사해서
# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채우세요. .env.local 은 git에 절대 올라가지
# 않습니다(.gitignore에 이미 등록됨) — 이 예시 파일만 커밋됩니다.

# 브라우저(클라이언트)에서 쓰는 공개 키 — RLS(행 단위 보안 정책)로 보호되므로 공개돼도 안전
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버(API 라우트)에서만 쓰는 관리자 키 — 절대 브라우저로 내려보내거나 git에 올리면 안 됨.
# Vercel 배포 시에는 Vercel 대시보드의 Environment Variables에 직접 입력하세요(이 파일에 값을
# 채워서 커밋하지 마세요).
SUPABASE_SERVICE_ROLE_KEY=

# ---- 네이버웍스 OAuth 로그인 (2026-09-15 추가) ----
# dev.worksmobile.com/kr 콘솔의 기존 앱(Client ID 3WO8wtlsZeib_aKM3Y0n) 기준.
# Redirect URL은 콘솔에 <배포주소>/api/auth/naverworks/callback 로 등록돼 있어야 함.
NAVERWORKS_CLIENT_ID=
NAVERWORKS_CLIENT_SECRET=

# 로그인 세션 쿠키에 서명할 임의의 긴 문자열. 터미널에서 아래처럼 만들면 됩니다:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 로컬 개발(localhost)이 아닌 실제 배포 주소. Vercel은 보통 자동으로 잡아주지만
# (VERCEL_URL), 커스텀 도메인을 쓰면 여기에 명시하세요. 예: https://moveout-theta.vercel.app
NEXT_PUBLIC_BASE_URL=

# ---- 네이버웍스 자동게시 (2026-09-15 추가) ----
# 실제 점검 리포트를 올릴 게시판의 ID. 네이버웍스 게시판 화면 URL이나
# 게시판 목록 API로 확인할 수 있음 — 어느 게시판인지 팀장님/기존 브라우저
# 자동화 쪽(웹앱A)에 확인 필요.
NAVERWORKS_BOARD_ID=

# ---- Cloudflare R2 저장소 (2026-09-16 추가, Supabase Storage 대체) ----
# dash.cloudflare.com → R2 Object Storage에서 버킷 하나 만들고(예: moveout-photos),
# 버킷 설정에서 "공개 개발 URL"을 켠 다음, "API 토큰 관리"에서 그 버킷 전용
# Access Key/Secret Key를 발급받아 채우세요. 계정 ID는 R2 개요 화면 우측에 있음.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC_URL=
# 버킷 이름이 moveout-photos가 아니면만 채우세요(기본값 moveout-photos).
R2_BUCKET_NAME=
